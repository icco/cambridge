{
  "name": "cambridge",
  "version": "1.0.0",
  "description": "An analog world clock art piece for a portrait screen in London.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nat Welch <nat@natwelch.com>",
  "repository": "https://github.com/icco/cambridge.git",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm type-check && pnpm format:check",
    "test:smoke": "node scripts/smoke.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@icco/react-common": "^2026.11104.1",
    "@opentelemetry/api": "~1.9.1",
    "@vercel/otel": "^2.3.0",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "openmeteo": "1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.4",
    "temporal-polyfill": "1.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
